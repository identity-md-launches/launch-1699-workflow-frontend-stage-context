{
  "name": "wake-graveyard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/deployment.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "verify": "node scripts/deployment.mjs --check",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.4.0",
    "@tanstack/react-query": "^5.104.2",
    "@wagmi/core": "^2.22.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.57.5",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "ws@^8": "^8.21.0"
  }
}
